# Lokale Entwicklung: `npm run db:start` startet einen Postgres auf Port 51214.
# pgbouncer=true + connection_limit=1: der lokale Prisma-Postgres teilt sich eine Session (sonst "prepared statement already exists")
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&pgbouncer=true&connection_limit=1"
DATABASE_URL_UNPOOLED="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&pgbouncer=true&connection_limit=1"

# Pflicht, mindestens 32 Zeichen. Erzeugen z. B. mit: openssl rand -hex 32
JWT_SECRET=""
