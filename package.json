{
  "name": "12-week-mastery",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c gray,green \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "node --env-file=.env --watch-path=server --import tsx server/dev.ts",
    "db:start": "prisma dev -d -n 12wm",
    "db:migrate": "prisma migrate dev",
    "build": "tsc && tsc -p tsconfig.server.json && vite build",
    "test": "vitest run",
    "vercel-build": "prisma generate && prisma migrate deploy && npm run build",
    "postinstall": "prisma generate",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@fontsource-variable/figtree": "5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "1.71.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.2.1",
    "prisma": "^6.19.3",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3",
    "vite": "^6.4.6",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
